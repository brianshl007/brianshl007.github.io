---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allProjects = await getCollection('projects');
const projects = allProjects.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Brian Lee" activeNav="works">

  <div class="page-title">
    <h1>Works</h1>
  </div>

  <section id="work">
    <div class="grid-wrap">
      <div class="grid">

        {projects.map((project) => {
          const slug = project.id.replace(/\.md$/, '');
          const isBlueEntry = slug === 'blue-jeeps';
          return (
            <a
              class:list={['grid-item', { 'blue-entry': isBlueEntry }]}
              href={`/work/${slug}`}
            >
              <div class:list={['grid-thumb', { 'ph-blue': isBlueEntry && !project.data.heroImage, 'ph': !project.data.heroImage && !isBlueEntry }]}>
                {project.data.heroImage && (
                  <img
                    src={project.data.heroImage}
                    alt={project.data.title}
                    onerror="this.style.display='none'"
                  />
                )}
              </div>
              <div class="grid-caption">
                <span class="grid-name">{project.data.title}</span>
              </div>
            </a>
          );
        })}

      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ─── GRID ─── */
  .grid-wrap {
    display: flex;
    justify-content: center;
    padding: 0 1.25rem 3rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 200px);
    gap: 16px;
    background: transparent;
  }

  .grid-item {
    display: block;
    text-decoration: none;
    color: inherit;
    background: var(--bg);
    position: relative;
  }

  .grid-thumb {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: #f0f0f0;
    position: relative;
  }

  .grid-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.3s;
  }

  .grid-item:hover .grid-thumb img { opacity: 0.85; }

  .grid-thumb.ph { background: #ebebeb; }
  .grid-thumb.ph-blue { background: #dce8f5; }

  .grid-caption {
    padding: 0.45rem 0.5rem 0.7rem;
  }

  .grid-name {
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    color: var(--ink);
    display: block;
  }

  .grid-item:hover .grid-name { color: var(--dim); }
  .grid-item.blue-entry .grid-name { color: var(--blue); }
  .grid-item.blue-entry:hover .grid-name { color: #1a3a6b; }

  /* ─── RESPONSIVE ─── */
  @media (max-width: 700px) {
    .grid-wrap { padding: 0 1rem 3rem; }
    .grid { grid-template-columns: repeat(2, 1fr); width: 100%; gap: 12px; }
  }

  @media (max-width: 420px) {
    .grid { grid-template-columns: 1fr; gap: 12px; }
  }
</style>
