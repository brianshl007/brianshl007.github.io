---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const entries = await getCollection('jeeps');
const jeeps = [...entries].sort((a, b) => {
  if (a.data.date && b.data.date) return a.data.date.getTime() - b.data.date.getTime();
  return 0;
});

// Placeholder background tones, cycling if collection grows beyond 9
const phTones = ['#c8d8ee','#b8cce6','#ccd8ec','#b4c8e2','#c2d2ea','#baced8','#c6d4e8','#b0c6e0','#c0d0e6'];
---

<BaseLayout
  title="Blue Jeeps — Brian Lee"
  description="A digital archive of blue jeeps encountered in the world."
  back={true}
  backLabel="← Back"
  bodyClass="jeep-page"
  footerLeft="Blue Jeeps — An Archive"
  footerRight="Brian Lee © 2026"
>

  <header class="page-header">
    <h1>Blue Jeeps</h1>
    <p class="header-note">A digital archive.<br />Blue jeeps, encountered in the world.</p>
  </header>

  <section class="archive">
    {jeeps.map((entry, i) => {
      const num = String(i + 1).padStart(3, '0');
      const tone = phTones[i % phTones.length];
      return (
        <div class="archive-item">
          <div class="archive-thumb" style={`background:${tone};`}>
            <img
              src={entry.data.image}
              alt={entry.data.caption ?? `Blue Jeep No. ${num}`}
            />
          </div>
          <div class="archive-caption">
            <span class="entry-title">No. {num}</span>
            {entry.data.caption && <p class="entry-note">{entry.data.caption}</p>}
          </div>
        </div>
      );
    })}
  </section>

</BaseLayout>

<style>
  /* ─── PAGE HEADER ─── */
  .page-header {
    padding: 6rem 2rem 2.5rem;
    border-bottom: 1px solid var(--blue-faint);
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    background: var(--blue-bg);
  }

  .page-header h1 {
    font-size: clamp(2rem, 4.5vw, 3.8rem);
    font-weight: 300;
    letter-spacing: -0.015em;
    color: var(--blue);
    font-style: normal;
  }

  .header-note {
    font-family: var(--mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--blue-dim);
    padding-bottom: 0.4rem;
    max-width: 36ch;
    text-align: right;
    line-height: 1.7;
  }

  /* ─── ARCHIVE GRID ─── */
  .archive {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3px;
    background: var(--blue-faint);
  }

  .archive-item {
    background: var(--bg);
    display: block;
  }

  .archive-thumb {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    position: relative;
  }

  .archive-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .archive-caption {
    padding: 0.5rem 0.7rem 0.8rem;
    border-top: 1px solid var(--blue-faint);
  }

  .entry-title {
    font-family: var(--mono);
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--blue);
    display: block;
    margin-bottom: 0.2rem;
  }

  .entry-note {
    font-size: 0.85rem;
    color: var(--ink-dim);
    line-height: 1.5;
    font-style: italic;
  }

  /* ─── RESPONSIVE ─── */
  @media (max-width: 900px) {
    .archive { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 600px) {
    .page-header {
      flex-direction: column;
      gap: 1rem;
      align-items: flex-start;
      padding: 5rem 1.25rem 2rem;
    }
    .header-note { text-align: left; }
    .archive { grid-template-columns: 1fr; }
  }
</style>
